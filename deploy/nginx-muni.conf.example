server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name zacatelco.gob.mx www.zacatelco.gob.mx;
    client_max_body_size 30M;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/zacatelco.gob.mx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zacatelco.gob.mx/privkey.pem;
    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name zacatelco.gob.mx www.zacatelco.gob.mx;
    client_max_body_size 30M;

    ssl_certificate /etc/letsencrypt/live/zacatelco.gob.mx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zacatelco.gob.mx/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        include proxy_params;
        proxy_pass http://unix:/run/muni/gunicorn.sock;
    }

    location /static/ {
        alias /srv/apps/muni/muni/staticfiles/;
    }
}
